# Existing Stripe configuration
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Brevo server-side API integration
# Generate at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Confirmed website leads list ID
BREVO_LEAD_LIST_ID=

# Double opt-in transactional template ID
BREVO_DOI_TEMPLATE_ID=

# Opt-in nurture campaign recipient list
BREVO_NURTURE_LIST_ID=

# Verified Brevo sender
BREVO_SENDER_NAME=KPIBoard
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO_EMAIL=

# Optional custom Brevo attribute names. Create these in Brevo before enabling.
BREVO_COMPANY_ATTRIBUTE=
BREVO_CHALLENGE_ATTRIBUTE=
BREVO_SOURCE_ATTRIBUTE=
